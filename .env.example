# Local runs only. Copy to .env and `set -a; . ./.env; set +a` - never commit .env.
# In GitHub Actions, pass these as action inputs (see README); the webhook should be a secret.

# Optional. Empty = print the digest only, never post.
SLACK_WEBHOOK_URL=

# Optional locally (unauthenticated works for public repos, but is rate-limited).
GITHUB_TOKEN=
GITHUB_REPO=owner/name

DIGEST_MODE=weekly        # weekly | release
DIGEST_DAYS=7             # weekly look-back window
RELEASE_TAG=              # release mode; empty = latest release
DIGEST_DRY_RUN=false      # true = never post, even with a webhook
DIGEST_FIXTURE=           # "sample" or a path to a fixture JSON = offline, skips GitHub
DIGEST_SHOW_FOOTER=true
